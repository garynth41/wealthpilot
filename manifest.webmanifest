{
  "name": "WealthPilot",
  "short_name": "WealthPilot",
  "description": "Personal budgeting, savings, investments, tax and financial planning.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#eceef1",
  "theme_color": "#ffffff",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add a transaction",
      "short_name": "Add",
      "description": "Log a purchase, deposit or transfer",
      "url": "./#/transactions?add=1",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Budget",
      "short_name": "Budget",
      "description": "This period's plan against what you spent",
      "url": "./#/budget",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Bills due",
      "short_name": "Bills",
      "description": "What is due and what is overdue",
      "url": "./#/bills",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Cash forecast",
      "short_name": "Forecast",
      "description": "Day-by-day cash for the weeks ahead",
      "url": "./#/forecast",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "categories": [
    "finance",
    "productivity"
  ]
}
