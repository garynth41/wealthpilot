{
  "name": "cresari",
  "private": true,
  "version": "0.27.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/smoke.mjs",
    "e2e:db": "node e2e/db.mjs",
    "db:test": "node scripts/db-test.mjs",
    "check": "npm run engines:sync -- --check && npm run typecheck && npm run test && npm run build && npm run e2e",
    "deploy": "npm run build && gh-pages -d dist --add --dotfiles --nojekyll",
    "lint": "oxlint",
    "engines:sync": "node scripts/sync-engines.mjs",
    "native:sync": "npm run build && cap sync",
    "native:assets": "node scripts/native-assets.mjs",
    "store:shots": "node scripts/store-shots.mjs",
    "fonts": "node scripts/fonts.mjs",
    "rollback": "node scripts/rollback.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-native-biometric": "^8.9.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "date-fns": "^4.4.0",
    "plotly.js-basic-dist-min": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "xlsx": "^0.18.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/plotly.js-basic-dist-min": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.92.0",
    "playwright": "^1.65.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
