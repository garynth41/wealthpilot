<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Cresari's privacy manifest (0.25.1). It matches the App Privacy answers in docs/STORE_LAUNCH.md and the privacy policy
     (public/privacy.html): no tracking, no tracking domains; everything the app keeps is linked to the person's account and used only to
     run the app. File timestamps: the file plugin (used to save exports before the share sheet opens) reads them for files inside the
     app's own container only (reason C617.1). -->
